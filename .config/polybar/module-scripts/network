#!/usr/bin/env bash
set -euo pipefail

mode="${1:-wifi}"

is_wireless_iface() {
    local iface="$1"
    [[ -d "/sys/class/net/${iface}/wireless" ]]
}

is_iface_connected() {
    local iface="$1"
    [[ -r "/sys/class/net/${iface}/operstate" ]] || return 1
    [[ "$(cat "/sys/class/net/${iface}/operstate")" == "up" ]] || return 1

    if [[ -r "/sys/class/net/${iface}/carrier" ]]; then
        [[ "$(cat "/sys/class/net/${iface}/carrier")" == "1" ]] || return 1
    fi
}

first_connected_ethernet_iface() {
    local path iface
    for path in /sys/class/net/*; do
        iface="${path##*/}"
        [[ "$iface" == "lo" ]] && continue
        is_wireless_iface "$iface" && continue
        is_iface_connected "$iface" || continue
        echo "$iface"
        return 0
    done
    return 1
}

first_wireless_iface() {
    local path iface
    for path in /sys/class/net/*; do
        iface="${path##*/}"
        is_wireless_iface "$iface" || continue
        echo "$iface"
        return 0
    done
    return 1
}

ipv4_for_iface() {
    local iface="$1"
    ip -o -4 addr show dev "$iface" 2>/dev/null | awk '{print $4}' | cut -d/ -f1 | head -n1
}

wifi_ssid() {
    local iface="$1" ssid=""

    # Query the kernel first so this works regardless of which daemon (NetworkManager, iwd) manages the link.
    if command -v iw >/dev/null 2>&1; then
        ssid="$(iw dev "$iface" link 2>/dev/null | sed -n 's/^[[:space:]]*SSID: //p' | head -n1)"
    fi
    if [[ -z "$ssid" ]] && command -v iwgetid >/dev/null 2>&1; then
        ssid="$(iwgetid "$iface" --raw 2>/dev/null || true)"
    fi
    if [[ -z "$ssid" ]] && command -v iwctl >/dev/null 2>&1; then
        ssid="$(iwctl station "$iface" show 2>/dev/null | sed -n 's/^.*Connected network[[:space:]]*//p' | sed 's/[[:space:]]*$//' | head -n1)"
    fi
    echo "$ssid"
}

show_ethernet() {
    local eth_iface eth_ip

    if ! eth_iface="$(first_connected_ethernet_iface)"; then
        # polybar keeps stale output unless a line is printed; an empty line hides the module
        echo ""
        exit 0
    fi

    eth_ip="$(ipv4_for_iface "$eth_iface")"
    if [[ -n "${eth_ip:-}" ]]; then
        echo "${eth_iface} ${eth_ip}"
    else
        echo "${eth_iface}"
    fi
}

show_wifi() {
    local wlan_iface ssid

    if first_connected_ethernet_iface >/dev/null; then
        echo ""
        exit 0
    fi

    if ! wlan_iface="$(first_wireless_iface)"; then
        echo "no wifi"
        exit 0
    fi

    ssid="$(wifi_ssid "$wlan_iface")"
    if [[ -n "${ssid:-}" ]]; then
        echo "${ssid}"
    else
        echo "no wifi"
    fi
}

case "$mode" in
    ethernet) show_ethernet ;;
    wifi) show_wifi ;;
    *) exit 1 ;;
esac
