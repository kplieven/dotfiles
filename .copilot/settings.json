{
  "allowedUrls": [
    "http://localhost:5200"
  ],
  "showReasoning": true,
  "enabledPlugins": {
    "superpowers@superpowers-marketplace": true,
    "obsidian@obsidian-skills": true
  },
  "extraKnownMarketplaces": {
    "superpowers-marketplace": {
      "source": {
        "source": "github",
        "repo": "obra/superpowers-marketplace"
      }
    }
  },
  "theme": "default",
  "notifications": false,
  "footer": {
    "showDirectory": true,
    "showBranch": true,
    "showContextWindow": true,
    "showQuota": true,
    "showAiUsed": true
  },
  "model": "auto",
  "statusLine": {
    "type": "command",
    "command": "node ~/.copilot/extensions/knowledge-tracking/statusline.mjs",
    "padding": 0
  },
  "experimental": true
}
