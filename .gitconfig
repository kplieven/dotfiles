[pull]
    rebase = true
[user]
    email = lvnskarel@gmail.com
    name = Karel Lievens
    signingkey = ~/.ssh/id_ed25519_gh_personal.pub
[commit]
    gpgsign = true
[gpg]
    format = ssh
[core]
    editor = nvim
[rebase]
    autosquash = true
[alias]
# Git Aliases
    st = status
    d = diff
    b = branch
    co = checkout
    glog = log --graph --oneline --decorate
    au = add -u
    cm = commit -m
    can = commit --amend --no-edit
    cf = commit --fix
    r = reset
    rh = reset --hard

## Git Push / Pull
    p = push
    pl = pull
    f = fetch
    r = remote --verbose
    pfwl = push --force-with-lease

## Git Submodule
    S = submodule
    Suir = submodule update --init --recursive
    wtf = !git add -u && git commit -m \"$(curl --silent --fail https://whatthecommit.com/index.txt)\"

[push]
    autoSetupRemote = true
    default = current
[credential]
    helper = store
; Work identity, scoped to the Barco tree. Must stay AFTER [user] above:
; later values win, so this overrides the personal default only in there.
[includeIf "gitdir:~/Repositories/Barco/"]
    path = ~/.gitconfig-barco
